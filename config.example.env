# Trinity Sales Register — Environment Config (EXAMPLE)
# Copy this file to "config.env" and fill in the real passwords.
# config.env is gitignored so secrets are never committed.

# ── Ramco ERP ────────────────────────────────────────────────
ERP_URL=https://peps.ramcoes.com/RVW/hub/index.html
ERP_USERNAME=PEPS69
ERP_PASSWORD=<RAMCO_PASSWORD>

# Download destination folder (the exported .xlsx lands here)
DOWNLOAD_DIR=D:\Hari JR. DATA\Performance issues\Auto -reports\Trinity Sales Register\downloads

# Duration log file (optional — leave blank to skip).
DURATION_LOG_FILE=D:\Hari JR. DATA\Performance issues\Reports Duration.xlsx

# Headless for unattended 7 AM runs (True/False)
HEADLESS=True
# Brief settle time replacing the old 30s visual-confirmation pauses.
SETTLE_SECS=2

# ── Outgoing Email (SMTP) ────────────────────────────────────
# Sends the downloaded Sales Register as an attachment, unmodified.
SMTP_SERVER=zimsmtp.logix.in
SMTP_PORT=587                          # STARTTLS
SMTP_USER=pepsit@pepsindia.com
SMTP_PASSWORD=<EMAIL_SMTP_PASSWORD>

EMAIL_FROM_NAME=PEPS India

# Recipients — adjust as needed
EMAIL_RECIPIENTS=trinity@pepsindia.com,hariit@pepsindia.com,trinitysupermarketshubil@gmail.com
EMAIL_CC=sales@pepsindia.com,janaki@pepsindia.com,itsupport@pepsindia.com

# Who gets the error-alert email if all download retries fail (ERP slow, etc.)
ERROR_EMAIL_RECIPIENTS=hariit@pepsindia.com
